<UserControl
    x:Class="HudControls.ToggleSwitch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HudControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="48"
    Height="64"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:MarginToVisibilityConverter x:Key="MarginToVisibilityConverter" />
        <Style TargetType="Image">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="8"
                        Direction="270"
                        ShadowDepth="4" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border Margin="5,7,5,7" CornerRadius="1">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"
                            Background="Black"
                            BorderBrush="Black"
                            BorderThickness="2"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}"
                            SnapsToDevicePixels="True" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <Grid ClipToBounds="True">
                <Border
                    Background="Black"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="1.5"
                    MouseDown="Door_PreviewMouseDown"
                    Visibility="{Binding SafetyCoverEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="10"
                            Direction="260"
                            ShadowDepth="6"
                            Color="White" />
                    </Border.Effect>
                </Border>
            </Grid>
        </Border>

        <Border
            Margin="6,8,6,8"
            Background="Black"
            CornerRadius="2"
            Opacity="0.4"
            Visibility="{Binding SafetyCoverEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Grid Margin="{Binding SafetyCoverEnabled, Converter={StaticResource MarginToVisibilityConverter}}" ClipToBounds="True">
            <Viewbox>
                <Image
                    x:Name="buttonImageOff"
                    Source="Assets/flip_up.png"
                    Visibility="Visible" />
            </Viewbox>
            <Viewbox>
                <Image
                    x:Name="buttonImageNone"
                    FlowDirection="RightToLeft"
                    Source="Assets/flip_none.png"
                    Visibility="Hidden" />
            </Viewbox>
            <Viewbox>
                <Image
                    x:Name="buttonImageOn"
                    FlowDirection="RightToLeft"
                    Source="Assets/flip_down.png"
                    Visibility="Hidden" />
            </Viewbox>
        </Grid>

        <Grid>
            <Grid
                Margin="6,14,6,8"
                Background="#01FFFFFF"
                MouseDown="OnMouseDown" />
            <Border
                Margin="4,6,4,6"
                BorderBrush="White"
                BorderThickness="2"
                CornerRadius="2"
                Opacity="0.15"
                Visibility="{Binding SafetyCoverEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border
                Margin="5,7,5,7"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="1.5"
                Visibility="{Binding SafetyCoverEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Grid
                x:Name="DoorContainer"
                Margin="6,8,6,8"
                ClipToBounds="True"
                Visibility="{Binding SafetyCoverEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid PreviewMouseDown="Door_PreviewMouseDown">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="DoorTransform" />
                    </Grid.RenderTransform>
                    <!--  The door that slides up  -->
                    <Border
                        x:Name="Door"
                        CornerRadius="1"
                        Opacity="0.6">
                        <Border.Background>
                            <LinearGradientBrush MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="8,0" EndPoint="0,8">
                                <GradientStop Offset="0.25" Color="#FFFF9B8B" />
                                <GradientStop Offset="0" Color="#FFFF9B8B" />
                                <GradientStop Offset="0.25" Color="#FFFF2300" />
                                <GradientStop Offset="1" Color="#FFFF2300" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <!--  TranslateTransform to move the door  -->
                    </Border>
                    <!--  The door handle  -->
                    <Rectangle
                        x:Name="Handle"
                        Height="4"
                        Margin="5,0,5,-1"
                        VerticalAlignment="Bottom"
                        Fill="#FF38383C"
                        Stroke="Black"
                        StrokeThickness="1" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
