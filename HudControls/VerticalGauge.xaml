<UserControl
    x:Class="HudControls.VerticalGauge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HudControls.Dependencies"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="25"
    mc:Ignorable="d">
    <Grid>
        <local:VerticalTicker x:Name="Ticker" />
        <local:VerticalIndicator x:Name="Indicator" />
    </Grid>
</UserControl>
