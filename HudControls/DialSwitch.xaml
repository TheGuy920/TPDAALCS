<UserControl
    x:Class="HudControls.DialSwitch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HudControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="100"
    Background="Transparent"
    Foreground="{Binding Foreground}"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            FontFamily="Unispace"
            FontSize="{Binding FontSize}"
            Text="OFF" />
        <Grid
            Grid.ColumnSpan="3"
            Width="50"
            Height="50"
            Margin="0,5,0,0"
            HorizontalAlignment="Center"
            MouseDown="GridMouseDown">
            <Grid.Effect>
                <DropShadowEffect Direction="270" ShadowDepth="3" />
            </Grid.Effect>
            <Ellipse
                x:Name="BackgroundEllipse"
                Margin="4"
                Fill="#FF1F1F1F"
                Stroke="Black"
                StrokeThickness="0.5" />
            <Ellipse
                x:Name="ForegroundEllipse"
                Margin="6"
                Fill="#19FFFFFF"
                Stroke="Black"
                StrokeThickness="0.5" />
            <Viewbox ClipToBounds="False">
                <Grid Margin="5.5,15,0,15" VerticalAlignment="Center">
                    <Path Data="M 6,-0.75 L 6,10.75 L -2,5 Z" Fill="Black" />
                    <Rectangle
                        Width="20"
                        Height="4"
                        Margin="3,-0.75,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Fill="Gray"
                        Stroke="Black"
                        StrokeThickness="0.5" />
                    <Path
                        x:Name="Triangle"
                        Data="M 6,0 L 6,10 L 0,5 Z"
                        Fill="Gray" />
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform X="-13" />
                            <RotateTransform x:Name="SwitchNeedleTransform" Angle="25" CenterX="8.75" CenterY="5" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                </Grid>
            </Viewbox>
        </Grid>
        <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontFamily="Unispace"
            FontSize="{Binding FontSize}"
            Text="ON"
            TextAlignment="Right" />
    </Grid>
</UserControl>
