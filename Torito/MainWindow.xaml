<Window
    x:Class="Torito.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hud="clr-namespace:HudControls;assembly=HudControls"
    xmlns:local="clr-namespace:Torito"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="950"
    Height="550"
    StateChanged="Window_StateChanged"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="hud:ControlContainer">
            <Setter Property="Source" Value="/Assets/screw_top_0.png" />
            <Setter Property="Background">
                <Setter.Value>
                    <ImageBrush
                        ImageSource="/Assets/met_text_5.jpg"
                        Opacity="1"
                        Stretch="UniformToFill" />
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Direction="230" ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="hud:HardContainer">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        Direction="270"
                        Opacity="0.75"
                        ShadowDepth="3" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid Background="Black" />
        <Grid>
            <Grid.Background>
                <ImageBrush
                    ImageSource="/Assets/met_text_5.jpg"
                    Opacity="0.6"
                    Stretch="None"
                    TileMode="FlipXY"
                    Viewport="0,0,0.1,0.1"
                    ViewportUnits="RelativeToBoundingBox" />
            </Grid.Background>
        </Grid>
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="150" />
                <RowDefinition Height="150" />
                <RowDefinition Height="150" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hud:ControlContainer>
                <hud:RadialGauge
                    x:Name="Gauge"
                    Title="PSI"
                    Margin="4"
                    Background="LightGray"
                    FontSize="9"
                    FontWeight="Bold"
                    MajorTickInterval="20"
                    MajorTickLabelOffset="5"
                    MajorTickWidthAndHeight="2,8"
                    MaxValue="401"
                    MinorTickInterval="8"
                    MinorTickWidthAndHeight="1,5"
                    NeedleLength="4.75"
                    NeedleWidth="2"
                    TitleFontFamily="Cascadia Code"
                    TitleFontSize="20"
                    TitleFontWeight="Black" />
            </hud:ControlContainer>
            <hud:ControlContainer
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Height="75"
                VerticalAlignment="Bottom">
                <UniformGrid Margin="20,0" Rows="1">
                    <hud:ToggleSwitch SafetyCoverEnabled="True" />
                    <hud:ToggleSwitch OnToggle="ToggleSwitch_OnToggle" SafetyCoverEnabled="True" />
                    <hud:ToggleSwitch />
                    <hud:ToggleSwitch />
                </UniformGrid>
            </hud:ControlContainer>
            <hud:ControlContainer
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Height="75"
                VerticalAlignment="Top">
                <UniformGrid Margin="20,0" Rows="1">
                    <hud:LedIndicator x:Name="LED" State="Error" />
                    <hud:LedIndicator x:Name="LED0" State="Warning" />
                    <hud:LedIndicator x:Name="LED1" State="Warning" />
                    <hud:LedIndicator x:Name="LED3" State="Success" />
                </UniformGrid>
            </hud:ControlContainer>
            <hud:ControlContainer Grid.Column="3">
                <hud:MasterCaution
                    x:Name="MasterCaution"
                    Width="100"
                    Height="70"
                    Background="Black"
                    BorderBrush="Black"
                    BorderThickness="1" />
            </hud:ControlContainer>
            <hud:ControlContainer
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2">
                <hud:HazardButton
                    x:Name="LaunchButton"
                    Margin="20"
                    BorderBrush="Black"
                    BorderThickness="1" />
            </hud:ControlContainer>
            <hud:ControlContainer Grid.Row="1" Grid.Column="3">
                <hud:HardContainer
                    Margin="20"
                    Padding="0"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="5">
                    <hud:HardContainer.Background>
                        <ImageBrush ImageSource="/Assets/met_text_3.jpg" />
                    </hud:HardContainer.Background>
                    <UniformGrid Margin="2" Columns="1">
                        <hud:DialSwitch
                            Margin="5,5,5,-10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom" />
                        <TextBlock
                            Margin="10,10,10,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="Unispace"
                            FontSize="18"
                            Foreground="Black"
                            Text="Valve 1">
                            <TextBlock.Effect>
                                <DropShadowEffect
                                    BlurRadius="1"
                                    ShadowDepth="1"
                                    Color="White" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </UniformGrid>
                </hud:HardContainer>
            </hud:ControlContainer>
            <hud:ControlContainer
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Top">
                <hud:HardLabel
                    Margin="20"
                    BackgroundImage="/Assets/met_text_3.jpg"
                    FontSize="18"
                    LabelText="TORITO PROJECT" />
            </hud:ControlContainer>
            <hud:ControlContainer Grid.RowSpan="2" Grid.Column="4">
                <hud:HardContainer
                    Margin="0,30"
                    HorizontalAlignment="Center"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="5">
                    <hud:HardContainer.Background>
                        <ImageBrush ImageSource="/Assets/met_text_3.jpg" />
                    </hud:HardContainer.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <hud:VerticalGauge
                            x:Name="VerticalGaugeA"
                            Grid.Row="0"
                            MinWidth="30"
                            Margin="20"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            FontWeight="Bold"
                            MajorTextAlign="Left"
                            MajorTextLabel="True"
                            MajorTickColor="Black"
                            MajorTickHeight="1"
                            MajorTickInterval="40"
                            MaxValue="400"
                            MinorTickColor="Black"
                            MinorTickHeight="0.5"
                            MinorTickInterval="10"
                            NeedleHeight="1"
                            NeedleLength="25" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            FontFamily="Unispace"
                            Text="PSI" />
                    </Grid>
                </hud:HardContainer>
            </hud:ControlContainer>
        </Grid>
    </Grid>
</Window>
